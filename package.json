  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.1",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
